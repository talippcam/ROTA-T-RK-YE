                        <div class="card border-0 rounded-0 mb-3">
                            <div class="article-text container-padding" data-text-id="405143" property="articleBody">
                                
                                <div class="post-flash">
        <!--<h3 class="post-flash__title">Gözden kaçırmayın</h3>-->
                <a class="d-block bg-danger text-light my-3 p-1" href="/corumda-pazar-gunu-hava-nasil-olacak-hafta-sonu-plani-yapanlara-uyari" title="Çorum’da pazar günü hava nasıl olacak? Hafta sonu planı yapanlara uyarı" target="_self">
            <div class="row g-0 align-items-center">
            <div class="col-5 col-sm-3">
                <img src="https://yaylahabercomtr.teimg.com/crop/250x150/yaylahaber-com-tr/uploads/2023/12/hava-durumu.JPG" loading="lazy" width="860" height="504" alt="Çorum’da pazar günü hava nasıl olacak? Hafta sonu planı yapanlara uyarı" class="img-fluid">
